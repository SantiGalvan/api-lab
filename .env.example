# apps/mytask — production environment (m2m auth mode)
MYTASK_URI=
MYTASK_M2M_TOKEN=

# apps/mytask — default credentials for login auth mode (used when login() is called with no arguments)
MYTASK_LOGIN_EMAIL=
MYTASK_LOGIN_PASSWORD=

# apps/mytask — fixtures used by scenarios (pre-existing records, never created by api-lab)
MYTASK_FIXTURE_PROJECT_ID=
MYTASK_FIXTURE_USER_ID=
MYTASK_FIXTURE_TASK_TYPE_ID=
